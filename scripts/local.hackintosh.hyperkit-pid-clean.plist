<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace __HOME__ with your home directory (see docs/DOCKER.md). -->
<plist version="1.0"><dict>
  <key>Label</key><string>local.hackintosh.hyperkit-pid-clean</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>__HOME__/.hackintosh/hyperkit-pid-clean.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/.hackintosh/hyperkit-pid-clean.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.hackintosh/hyperkit-pid-clean.log</string>
</dict></plist>
